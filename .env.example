# Server
PORT=3500

# PostgreSQL (local development defaults)
PGHOST=localhost
PGPORT=5432
PGDATABASE=app_db
PGUSER=app_user
PGPASSWORD=replace_with_a_local_development_password
PGSSLMODE=disable

# Firebase Authentication
# Create a restricted key allowing only Identity Toolkit API and Token Service API.
FIREBASE_API_KEY=replace_with_your_firebase_api_key

# OpenAI
# Create this key in the OpenAI dashboard. Never commit a real value.
OPEN_AI_API_KEY=replace_with_your_openai_api_key
